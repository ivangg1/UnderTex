# Copy to `.env` (git-ignored) to bake network settings into the build.
# Everything here is optional; the app also accepts these from Profile at runtime.

# Your own y-webrtc signaling server (see ../signaling-server and ../render.yaml).
# Tried first, before the public fallback servers.
VITE_SIGNALING_SERVER=wss://latex-p2p-signaling.onrender.com

# TURN relay, needed only when peers sit behind symmetric NATs (some corporate /
# mobile networks). Comma separated URLs are accepted.
# VITE_TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
# VITE_TURN_USERNAME=user
# VITE_TURN_CREDENTIAL=secret
